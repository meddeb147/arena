{
  "name": "stake-arena",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/engine",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm run dev -w @arena/server\" \"npm run dev -w @arena/client\"",
    "dev:server": "npm run dev -w @arena/server",
    "build": "npm run build -w @arena/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "bench": "npm run bench -w @arena/server",
    "check": "npm run typecheck && npm test",
    "dev:client": "npm run dev -w @arena/client",
    "start": "npm start -w @arena/server"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
