{
  "name": "stake-arena-promo",
  "private": true,
  "description": "Stake Arena promotional video (Remotion). Separate from the game workspaces.",
  "type": "module",
  "scripts": {
    "audio": "node audio/synth.mjs",
    "capture:serve": "vite --config capture/vite.config.ts --port 5199 --strictPort",
    "capture": "node capture/capture-all.cjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Promo out/stake-arena-promo.mp4",
    "render:vertical": "remotion render src/index.ts PromoVertical out/stake-arena-promo-vertical.mp4",
    "thumbnail": "remotion still src/index.ts Thumbnail out/stake-arena-thumbnail.png",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fontsource/bungee": "^5.2.0",
    "@fontsource/nunito": "^5.2.0",
    "@remotion/cli": "4.0.542",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
